# Copy to .env (never commit it) or export these in your shell.
# OpenAlex now needs a free API key: https://openalex.org  (account -> API key)
OPENALEX_API_KEY=
# Optional: raises Semantic Scholar rate limits
S2_API_KEY=
# Optional: your email, sent in the User-Agent / Crossref "polite pool"
CONTACT_EMAIL=
